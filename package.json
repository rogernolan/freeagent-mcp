{
  "name": "freeagent-mcp",
  "version": "0.1.0",
  "description": "Allow AI systems to do bookkeeping in FreeAgent via MCP",
  "bin": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "npm run build && node ./dist/main.js",
    "start:http": "npm run build && MCP_TRANSPORT=http node ./dist/main.js",
    "auth": "npm run build && node ./dist/main.js auth",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint",
    "clean": "rm -rf dist",
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-domdomegg": "^2.0.9",
    "tsconfig-domdomegg": "^1.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "private": true
}
